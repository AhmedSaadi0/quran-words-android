    <string name="guide_title">Quranic terminology &amp; morphology guide</string>
    <string name="guide_method_title">Morphology &amp; grammar methodology</string>
    <string name="guide_method_body">The app reduces Quranic words to their triliteral and quadriliteral roots, identifying verb forms, derivative patterns and masadirs based on the Leeds Quranic Arabic Corpus (Quranic Arabic Corpus) and accredited heritage lexicons.</string>
